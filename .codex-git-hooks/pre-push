#!/bin/sh
# Refuse pushes that would write or delete protected refs.
set -u
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "pre-push: pushing to main is forbidden (protected ref)" >&2
      status=1
      ;;
    refs/tags/*)
      echo "pre-push: tag push or deletion is forbidden (protected ref)" >&2
      status=1
      ;;
  esac
done
exit "$status"
